# Copy to .env on the instance (never commit it). Generate secrets with:
#   openssl rand -hex 32

# Three free DuckDNS names, all pointing at the instance's public IP.
APP_DOMAIN=connect-CHANGE_ME.duckdns.org
API_DOMAIN=connect-api-CHANGE_ME.duckdns.org
LIVE_DOMAIN=connect-live-CHANGE_ME.duckdns.org
DUCKDNS_TOKEN=CHANGE_ME

# Instance -> Attached VNICs -> primary VNIC: public IP / private IP (10.0.0.149).
PUBLIC_IP=CHANGE_ME
PRIVATE_IP=10.0.0.149

# The backend in Coolify needs the same TURN_SECRET; LiveKit's key/secret are
# for the stream integration (secret >= 32 chars).
TURN_SECRET=CHANGE_ME
LIVEKIT_API_KEY=connect
LIVEKIT_API_SECRET=CHANGE_ME
