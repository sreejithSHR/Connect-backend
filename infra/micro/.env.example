# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# DuckDNS name pointing at this instance (API, Socket.IO and TURN all use it).
API_DOMAIN=connect-api.duckdns.org
# duckdns.org -> your account -> token
DUCKDNS_TOKEN=

# Where the frontend is served: the Cloudflare Pages URL, plus a custom domain
# if you add one (comma-separated, no trailing slash).
APP_ORIGIN=https://connect.pages.dev

# Instance -> Attached VNICs -> primary VNIC: public IP / private IP (10.0.x.x).
PUBLIC_IP=
PRIVATE_IP=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
TURN_SECRET=

# Optional: Google OAuth "Web application" client ID. Empty -> email + password only.
GOOGLE_CLIENT_ID=

STREAM_MAX_VIEWERS=15
MEET_MAX_PARTICIPANTS=6
