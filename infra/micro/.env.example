# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Name pointing at this instance (API, Socket.IO and TURN all use it): an A
# record on your own domain (DNS only, never proxied), or a DuckDNS name.
API_DOMAIN=connect-api.example.com
# Only for a *.duckdns.org API_DOMAIN: duckdns.org -> your account -> token
DUCKDNS_TOKEN=

# Where the frontend is served: the custom domain and/or the Cloudflare Pages
# URL (comma-separated, no trailing slash).
APP_ORIGIN=https://connect.example.com,https://connect.pages.dev

# Instance -> Attached VNICs -> primary VNIC: public IP / private IP (10.0.x.x).
PUBLIC_IP=
PRIVATE_IP=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
TURN_SECRET=

# Optional: Google OAuth "Web application" client ID. Empty -> email + password only.
GOOGLE_CLIENT_ID=

STREAM_MAX_VIEWERS=15
MEET_MAX_PARTICIPANTS=6
