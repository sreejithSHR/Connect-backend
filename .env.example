# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins, or * for any (dev only)
ORIGIN=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local docker-compose default:
DATABASE_URL=postgresql://connect:connect@localhost:5432/connect?schema=public

# ---- Redis ----
# Used for presence, viewer counts and the Socket.IO adapter (horizontal scale-out).
# Leave empty to run a single instance with an in-memory fallback (dev only).
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Signs session tokens. Required in production (openssl rand -hex 32); in dev a
# random one is used and everyone is logged out on restart.
JWT_SECRET=
# Google sign-in: OAuth client ID of type "Web application" from Google Cloud
# Console -> APIs & Services -> Credentials. Empty -> only email + password.
GOOGLE_CLIENT_ID=

# ---- Room capacity ----
# Media is peer-to-peer at 720p: the host encodes + uploads one ~1 Mbps copy per
# viewer. 15 viewers ~= 15 Mbps up; beyond that most laptops/uplinks struggle.
STREAM_MAX_VIEWERS=15
# Full mesh: every participant encodes + uploads to every other one.
MEET_MAX_PARTICIPANTS=6

# ---- TURN (coturn, see infra/coturn) ----
# Must match coturn's static-auth-secret. Empty -> STUN only (~10-15% of users
# on strict networks will fail to connect).
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=change-me
# TURN_TTL_SECONDS=21600
